# ────────────────────────────────────────────────────────────
# CampusWorkflow — variables d'environnement (racine du projet)
# ────────────────────────────────────────────────────────────
# Copier ce fichier vers .env avant de lancer `docker compose up --build` :
#   cp .env.example .env
#
# Toutes les variables ci-dessous ont une valeur par défaut dans
# docker-compose.yml SAUF JWT_SECRET, qui doit être définie.

# Secret utilisé pour signer les JWT (auth-service, gateway, finance-service).
# Générer une valeur aléatoire, par ex. : openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# ── Identifiants base de données (communs à tous les services Postgres) ──
DB_USER=campus_user
DB_PASSWORD=campus_pass

# ── Redis ──
REDIS_PASSWORD=redis_pass

# ── RabbitMQ ──
RABBITMQ_USER=campus_rabbit
RABBITMQ_PASS=rabbit_pass

# ── Seed des comptes de démonstration (auth-service) ──
# Voir QUICK_START.md pour la liste des comptes créés.
DB_AUTO_SEED=true

# ── URLs publiques (utilisées par le navigateur / CORS) ──
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://gateway:3000,http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# ── Ports exposés sur la machine hôte ──
FRONTEND_PORT=5173
GATEWAY_PORT=3000
AUTH_PORT=8001
ACADEMIC_PORT=8002
FINANCE_PORT=8003
HR_PORT=8004
MESSAGE_PORT=8005
NOTIFICATION_PORT=8006

# ── SMTP (optionnel — reset de mot de passe par email) ──
# Laisser vide en développement : les emails ne partiront pas mais
# l'application continue de fonctionner normalement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@campus.local
