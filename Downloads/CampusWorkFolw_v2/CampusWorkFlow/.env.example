# ────────────────────────────────────────────────────────────
# CampusWorkflow — variables d'environnement (racine du projet)
# ────────────────────────────────────────────────────────────
# Copier ce fichier vers .env uniquement pour personnaliser les valeurs locales :
#   cp .env.example .env
# Sans fichier .env, Compose utilise ses valeurs locales par défaut.
#
# Valeurs exclusivement locales de développement. Ne déployez jamais ces
# identifiants en production ; consultez PRODUCTION_DEPLOYMENT.md.
APP_ENV=development

# Secret utilisé pour signer les JWT (auth-service, gateway, finance-service).
# Générer une valeur aléatoire, par ex. : openssl rand -base64 48
JWT_SECRET=local-dev-secret-not-for-production-0000000000000000

# Identifiants PostgreSQL communs aux six bases isolées.
# Seules DB_USER et DB_PASSWORD sont nécessaires pour personnaliser PostgreSQL.
DB_USER=campus_user
DB_PASSWORD=local-dev-db-password

# ── Redis ──
REDIS_PASSWORD=local-dev-redis-password

# ── RabbitMQ ──
RABBITMQ_USER=campus_rabbit
RABBITMQ_PASS=local-dev-rabbit-password

# ── Seed des comptes de démonstration (auth-service) ──
# Les comptes de démonstration restent désactivés par défaut.
DB_AUTO_SEED=false

# ── URLs publiques (utilisées par le navigateur / CORS) ──
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://gateway:3000,http://localhost:5173
VITE_API_URL=http://localhost:3000/api

# ── Ports exposés sur la machine hôte ──
FRONTEND_PORT=5173
GATEWAY_PORT=3000
AUTH_PORT=8001
ACADEMIC_PORT=8002
FINANCE_PORT=8003
HR_PORT=8004
MESSAGE_PORT=8005
NOTIFICATION_PORT=8006

# ── SMTP (optionnel — reset de mot de passe par email) ──
# Laisser vide en développement : les emails ne partiront pas mais
# l'application continue de fonctionner normalement.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@campus.local
