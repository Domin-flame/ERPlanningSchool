# CampusWorkflow — copier ce fichier vers .env puis renseigner les valeurs adaptées.
# Toutes les valeurs ci-dessous sont destinées au développement local.
# Ne déployez pas ces identifiants en production. Voir PRODUCTION_DEPLOYMENT.md.
APP_ENV=development

# Secret JWT partagé par les services (développement seulement).
# Production : openssl rand -hex 32
JWT_SECRET=local-dev-secret-not-for-production-0000000000000000

# Identifiants PostgreSQL partagés par les six bases séparées.
DB_USER=campus_user
DB_PASSWORD=local-dev-db-password

# Redis et RabbitMQ
REDIS_PASSWORD=local-dev-redis-password
RABBITMQ_USER=campus_rabbit
RABBITMQ_PASS=local-dev-rabbit-password

# Données de démonstration du catalogue/comptes (false par défaut)
DB_AUTO_SEED=false

# Origines frontend autorisées et URL API intégrée au bundle frontend
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:3000/api

# Ports frontend/gateway publiés sur la machine hôte
FRONTEND_PORT=5173
GATEWAY_PORT=3000
SWAGGER_SERVER_URL=http://localhost:3000

# Cible du proxy Vite en mode développement (npm run dev, hors Docker)
BACKEND_URL=http://localhost:3000

# Chatbot IA — fournisseur compatible avec l’API OpenAI Chat Completions.
# La clé reste côté serveur (gateway), jamais dans une variable VITE_*.
# Renseignez la clé fournie par votre fournisseur ; ne la partagez pas ici.
CHATBOT_API_KEY=
CHATBOT_API_URL=https://openrouter.ai/api/v1/chat/completions
CHATBOT_MODEL=openai/gpt-4o-mini
CHATBOT_SITE_URL=http://localhost:5173

# SMTP (optionnel : réinitialisation de mot de passe par e-mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@campus.local

# Prix finance (optionnel, valeurs par défaut définies par le service)
FINANCE_PRICE_PER_CREDIT=15000
FINANCE_INVOICE_DUE_DAYS=30

# URLs internes Compose (ne changer que si les noms/ports des services changent)
AUTH_SERVICE_URL=http://auth-service:8001
ACADEMIC_SERVICE_URL=http://academic-service:8002
FINANCE_SERVICE_URL=http://finance-service:8003
HR_SERVICE_URL=http://hr-service:8004
MESSAGE_SERVICE_URL=http://message-service:8005
NOTIFICATION_SERVICE_URL=http://notification-service:8006
BACKEND_UPSTREAM=http://gateway:3000
